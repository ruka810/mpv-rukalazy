{
  "manifest_version": 3,
  "name": "mpv Chrome Cookie Bridge",
  "version": "1.2.0",
  "description": "Makes the currently signed-in Bilibili and YouTube Chrome cookies available to local mpv in memory only.",
  "key": "",
  "permissions": ["cookies", "alarms", "nativeMessaging"],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://*.youtube.com/*",
    "https://*.google.com/*",
    "https://youtu.be/*",
    "http://127.0.0.1:49814/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:49814 ws://127.0.0.1:49814"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "mpv Chrome Cookie Bridge" }
}
